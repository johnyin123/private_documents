#include "xdp_parse.h"
char _license[] SEC("license") = "GPL";
#define IP_ADDRESS(x) (unsigned int)(172 + (17 << 8) + (0 << 16) + (x << 24))
#define BACKEND_A 2
#define BACKEND_B 3
#define CLIENT 4
#define LB 5

SEC("xdp") int xdp_load_balancer(struct xdp_md *ctx) {
    void *data = (void *)(long)ctx->data;
    void *data_end = (void *)(long)ctx->data_end;
    struct hdr_cursor nh = { .pos = data };
    struct ethhdr *eth;
    struct iphdr *iphdr;
    struct tcphdr *tcphdr;
    if (parse_ethhdr(&nh, data_end, &eth) != bpf_htons(ETH_P_IP)) { return XDP_PASS; }
    if (parse_iphdr(&nh, data_end, &iphdr) != IPPROTO_TCP) { return XDP_PASS; }
    if (parse_tcphdr(&nh, data_end, &tcphdr) < 0) { return XDP_PASS; }
    if (iphdr->saddr == IP_ADDRESS(CLIENT)) {
        char be = (bpf_ktime_get_ns() % 2) ? BACKEND_A : BACKEND_B;
        iphdr->daddr = IP_ADDRESS(be);
        eth->h_dest[5] = be;
    } else {
        iphdr->daddr = IP_ADDRESS(CLIENT);
        eth->h_dest[5] = CLIENT;
    }
    iphdr->saddr = IP_ADDRESS(LB);
    eth->h_source[5] = LB;
    iphdr->check = iph_csum(iphdr);
    return XDP_TX;
}
